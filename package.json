    "@iconify-json/lucide": "^1.2.108",
    "@iconify-json/simple-icons": "^1.2.83",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "3.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "4.0.3",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/i18n": "10.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
